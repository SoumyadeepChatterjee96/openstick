<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monitor_root"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/monitor_live"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bsl_text_dim"
            android:id="@+id/monitor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_monitor_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bsl_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_monitor_cpu"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/bsl_accent"
                android:id="@+id/monitor_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bsl_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_monitor_memory"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/bsl_accent"
                android:id="@+id/monitor_memory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bsl_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_monitor_processes"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/bsl_accent"
                android:id="@+id/monitor_processes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/monitor_budget"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="32"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/bsl_text_dim"
        android:gravity="center"
        android:id="@+id/monitor_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
