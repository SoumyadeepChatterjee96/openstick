#!/bin/sh
# openstick-fetch — responsive system info fetch tool for OpenStick Linux.
# Auto-adjusts layout dynamically based on terminal width.
set -u

# ---------------------------------------------------------------- terminal width
COLS=${COLUMNS:-}
[ -z "$COLS" ] && COLS=$(stty size 2>/dev/null | awk '{print $2}')
[ -z "$COLS" ] && COLS=$(tput cols 2>/dev/null)
[ -z "$COLS" ] && COLS=80

# ---------------------------------------------------------------- colors
if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
    e() { printf '\033[%sm' "$1"; }
    CYAN=$(e '38;2;77;208;225'); KEY=$(e '1;38;2;77;208;225')
    DIM=$(e '38;2;136;130;124'); BOLD=$(e '1'); R=$(e 0)
else
    CYAN=''; KEY=''; DIM=''; BOLD=''; R=''
fi

host() { [ -r "/run/bsl/$1" ] && cat "/run/bsl/$1" 2>/dev/null; }

UH="$(id -un)@$(hostname 2>/dev/null || echo openstick)"
VER=$(host app_version)
[ -z "$VER" ] && VER="1.0.0"

if [ "${OPENSTICK_TERMINAL:-${BREADSTICK_TERMINAL:-0}}" = 1 ];   then M="Terminal"
elif [ "${OPENSTICK_ROOTLESS:-${BREADSTICK_ROOTLESS:-0}}" = 1 ]; then M="Floating"
elif [ -n "${DISPLAY:-}" ];                                      then M="Desktop"
else                                                             M="Terminal"; fi

OS_NAME="$( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-OpenStick Linux}" )"
ARCH="$(uname -m 2>/dev/null)"
KERNEL="$(uname -r 2>/dev/null)"

UPTIME=""
[ -r /proc/uptime ] && UPTIME="$(awk '{d=int($1/86400);h=int(($1%86400)/3600);m=int(($1%3600)/60);
    if(d)printf "%dd %dh",d,h; else if(h)printf "%dh %dm",h,m; else printf "%dm",m}' /proc/uptime 2>/dev/null)"

MEM="$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2}
    END{if(t) printf "%.1fG / %.1fG", (t-a)/1048576, t/1048576}' /proc/meminfo 2>/dev/null)"

DISK="$(df -h "${HOME:-/root}" 2>/dev/null | awk 'NR==2{printf "%s / %s (%s free)", $3, $2, $4}')"

BAT=""
B=$(host battery)
if [ -n "$B" ] && [ "$B" != -1 ]; then
    [ "$(host battery_charging)" = 1 ] && BAT="${B}%, charging" || BAT="${B}%"
fi

# ---------------------------------------------------------------- narrow layout (COLS < 55)
if [ "$COLS" -lt 55 ]; then
    printf '\n'
    printf '  %s%sOpenStick Linux%s %s(%s)%s\n' "$CYAN" "$BOLD" "$R" "$DIM" "$ARCH" "$R"
    printf '  %s%s%s\n' "$KEY" "$UH" "$R"
    printf '  %s--------------------------------%s\n' "$DIM" "$R"
    [ -n "$OS_NAME" ] && printf '  %sOS:%s      %s\n' "$KEY" "$R" "$OS_NAME"
    [ -n "$KERNEL" ]  && printf '  %sKernel:%s  %s\n' "$KEY" "$R" "$KERNEL"
    [ -n "$UPTIME" ]  && printf '  %sUptime:%s  %s\n' "$KEY" "$R" "$UPTIME"
    [ -n "$MEM" ]     && printf '  %sMemory:%s  %s\n' "$KEY" "$R" "$MEM"
    [ -n "$DISK" ]    && printf '  %sDisk:%s    %s\n' "$KEY" "$R" "$DISK"
    [ -n "$BAT" ]     && printf '  %sBattery:%s %s\n' "$KEY" "$R" "$BAT"
    printf '\n'
    exit 0
fi

# ---------------------------------------------------------------- wide layout (COLS >= 55)
TMPA=$(mktemp) || exit 0
TMPI=$(mktemp) || { rm -f "$TMPA"; exit 0; }
trap 'rm -f "$TMPA" "$TMPI"' EXIT INT TERM

cat > "$TMPA" <<'ART'
   .------.
  |  .--.  |
  |  |  |  |
  |  '--'  |
  |  Open  |
  |  Stick |
  |  ====  |
  |  |  |  |
   --'  '--
ART

row() {
    [ -n "${2:-}" ] || return 0
    printf '%s%s:%s %s\n' "$KEY" "$1" "$R" "$2" >> "$TMPI"
}

printf '%s%s%s\n' "$KEY" "$UH" "$R" >> "$TMPI"
printf '%s%s%s\n' "$DIM" "$(printf '%*s' ${#UH} '' | tr ' ' '-')" "$R" >> "$TMPI"

row OpenStick "$VER  ${DIM}(FOSS)${R}"
row Mode "$M"
row OS "$OS_NAME  ${DIM}$ARCH${R}"
row Kernel "$KERNEL"
[ -n "$UPTIME" ] && row Uptime "$UPTIME"
[ -n "$MEM" ] && row Memory "$MEM"
[ -n "$DISK" ] && row Disk "$DISK"
[ -n "$BAT" ] && row Battery "$BAT"

printf '\n'
awk -v c="$CYAN" -v r="$R" '
    NR==FNR { a[FNR]=$0; na=FNR; next }
    { i[FNR]=$0; ni=FNR }
    END {
        n = (na > ni ? na : ni)
        for (k = 1; k <= n; k++)
            printf "  %s%-14s%s  %s\n", c, (k in a ? a[k] : ""), r, (k in i ? i[k] : "")
    }' "$TMPA" "$TMPI"

if [ -n "$CYAN" ]; then
    printf '  '
    for s in 77\;208\;225 66\;133\;244 52\;168\;83 251\;188\;4 234\;67\;53; do
        printf '\033[48;2;%sm   \033[0m' "$s"
    done
    printf '\n'
fi
printf '\n'
